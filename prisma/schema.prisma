datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(uuid())
  name         String
  phone        String      @unique
  email        String?
  passwordHash String?
  role         String      @default("CUSTOMER") // SUPER_ADMIN, SALON_OWNER, STAFF, CUSTOMER
  salonId      String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  salon        Salon?      @relation(fields: [salonId], references: [id], onDelete: Cascade)
  staffProfile SalonStaff?
  customer     Customer?
}

model Salon {
  id           String      @id @default(uuid())
  name         String
  logoUrl      String?
  address      String
  city         String      @default("Mumbai")
  state        String      @default("Maharashtra")
  pincode      String      @default("400001")
  phone        String
  email        String?
  status       String      @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  users                User[]
  businessHours        BusinessHours[]
  staff                SalonStaff[]
  categories           ServiceCategory[]
  services             Service[]
  customers            Customer[]
  appointments         Appointment[]
  payments             Payment[]
  offers               Offer[]
  loyaltyAccounts      LoyaltyAccount[]
  reviews              Review[]
  notifications        Notification[]
  subscriptions        Subscription[]
  subscriptionPayments SubscriptionPayment[]
  settings             SalonSettings?
}

model BusinessHours {
  id        String   @id @default(uuid())
  salonId   String
  dayOfWeek Int      // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  openTime  String   // "09:00"
  closeTime String   // "20:00"
  isClosed  Boolean  @default(false)

  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model SalonStaff {
  id             String        @id @default(uuid())
  salonId        String
  userId         String?       @unique
  name           String
  photoUrl       String?
  phone          String
  role           String        @default("Hair Stylist & Beautician")
  workingHours   String        @default("09:00 AM - 08:00 PM")
  activeServices String        @default("All")
  isLeave        Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())

  salon          Salon         @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id])
  appointments   Appointment[]
}

model ServiceCategory {
  id        String    @id @default(uuid())
  salonId   String
  name      String
  sortOrder Int       @default(0)

  salon     Salon     @relation(fields: [salonId], references: [id], onDelete: Cascade)
  services  Service[]
}

model Service {
  id               String          @id @default(uuid())
  salonId          String
  categoryId       String
  name             String
  price            Float
  durationMinutes  Int
  rebookingDays    Int             @default(30)
  description      String?
  imageUrl         String?
  assignedStaffIds String?         @default("")
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())

  salon            Salon           @relation(fields: [salonId], references: [id], onDelete: Cascade)
  category         ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  appointmentItems AppointmentService[]
}

model Customer {
  id                 String               @id @default(uuid())
  salonId            String
  userId             String?              @unique
  name               String
  phone              String
  email              String?
  birthday           String?
  gender             String?              @default("Female")
  notes              String?
  preferredStaffId   String?
  preferredServiceId String?
  totalVisits        Int                  @default(0)
  totalSpend         Float                @default(0.0)
  lastVisitDate      DateTime?
  createdAt          DateTime             @default(now())

  salon              Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  user               User?                @relation(fields: [userId], references: [id])
  appointments       Appointment[]
  payments           Payment[]
  loyaltyAccount     LoyaltyAccount?
  reviews            Review[]
  notifications      Notification[]
}

model Appointment {
  id              String               @id @default(uuid())
  salonId         String
  customerId      String
  staffId         String
  appointmentDate String               // "YYYY-MM-DD"
  startTime       String               // "10:00 AM"
  endTime         String               // "10:45 AM"
  status          String               @default("PENDING") // PENDING, CONFIRMED, ARRIVED, SERVICE_STARTED, COMPLETED, CANCELLED, NO_SHOW
  paymentStatus   String               @default("PENDING") // PENDING, PAID, PARTIAL, REFUNDED
  totalAmount     Float                @default(0.0)
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  salon           Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer        Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff           SalonStaff           @relation(fields: [staffId], references: [id], onDelete: Cascade)
  services        AppointmentService[]
  payment         Payment?
  review          Review?
}

model AppointmentService {
  id              String      @id @default(uuid())
  appointmentId   String
  serviceId       String
  price           Float
  durationMinutes Int

  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service         Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(uuid())
  salonId       String
  appointmentId String   @unique
  customerId    String
  subtotal      Float
  discountAmount Float   @default(0.0)
  taxAmount     Float    @default(0.0)
  finalAmount   Float
  paymentMethod String   @default("CASH") // CASH, UPI, CARD, OTHER
  receiptNumber String   @unique
  createdAt     DateTime @default(now())

  salon         Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Offer {
  id                 String   @id @default(uuid())
  salonId            String
  code               String
  name               String
  description        String?
  discountType       String   @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue      Float
  startDate          String
  endDate            String
  applicableServices String   @default("ALL")
  maxUsage           Int      @default(100)
  usedCount          Int      @default(0)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  salon              Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model LoyaltyAccount {
  id            String               @id @default(uuid())
  salonId       String
  customerId    String               @unique
  pointsBalance Int                  @default(0)
  totalEarned   Int                  @default(0)
  totalRedeemed Int                  @default(0)
  updatedAt     DateTime             @updatedAt

  salon         Salon                @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions  LoyaltyTransaction[]
}

model LoyaltyTransaction {
  id               String         @id @default(uuid())
  loyaltyAccountId String
  amount           Float          @default(0.0)
  points           Int
  transactionType  String         // "EARN" or "REDEEM"
  description      String
  createdAt        DateTime       @default(now())

  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
}

model Review {
  id            String      @id @default(uuid())
  salonId       String
  customerId    String
  appointmentId String      @unique
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())

  salon         Salon       @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String   @id @default(uuid())
  salonId    String
  customerId String?
  type       String   // BOOKING, CONFIRMATION, ARRIVAL, STARTED, COMPLETED, REBOOKING
  channel    String   @default("WHATSAPP") // WHATSAPP, SMS, PUSH
  recipient  String
  message    String
  status     String   @default("SENT") // PENDING, SENT, FAILED
  createdAt  DateTime @default(now())

  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Subscription {
  id        String   @id @default(uuid())
  salonId   String
  planName  String   @default("SalonOsa Annual Plan")
  price     Float    @default(2999.0)
  startDate DateTime @default(now())
  expiryDate DateTime
  status    String   @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  autoRenew Boolean  @default(true)
  createdAt DateTime @default(now())

  salon     Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  payments  SubscriptionPayment[]
}

model SubscriptionPayment {
  id             String       @id @default(uuid())
  subscriptionId String
  salonId        String
  amount         Float
  paymentMethod  String       @default("UPI")
  transactionRef String
  status         String       @default("SUCCESS")
  createdAt      DateTime     @default(now())

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  salon          Salon        @relation(fields: [salonId], references: [id], onDelete: Cascade)
}

model SalonSettings {
  id                       String   @id @default(uuid())
  salonId                  String   @unique
  whatsappApiKey           String?  @default("demo_whatsapp_key_77812")
  whatsappPhoneId          String?  @default("+91 98765 43210")
  autoRemindersEnabled     Boolean  @default(true)
  rebookingRemindersEnabled Boolean @default(true)
  loyaltyPointsPer100      Int      @default(5)
  pointRedemptionValue     Float    @default(0.5) // 1 point = ₹0.50

  salon                    Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
}
